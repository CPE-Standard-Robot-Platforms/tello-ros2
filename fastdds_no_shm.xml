<?xml version="1.0" encoding="UTF-8"?>
<!--
Fast DDS profile forcing plain UDPv4 and disabling the shared memory transport.

Fast DDS uses shared memory by default to talk between processes on the same
machine, backed by /dev/shm. A container and the host do not reliably share
that segment even with "docker run --ipc host" (observed: topics discover
each other and report a matched publisher/subscriber, but no message data
ever arrives). Restricting the participant to UDPv4 only sidesteps the
mismatch entirely, at the cost of local loopback traffic going through the
network stack instead of shared memory.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_only</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="udp_only_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_only</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
